# ─── Sanity ─────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# ─── Stripe ─────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Site ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Indexation ─────────────────────────────────
# L'indexation exige TROIS conditions cumulatives :
#   1. VERCEL_ENV === "production"  (posé par Vercel, non contournable —
#      une prévisualisation n'est donc JAMAIS indexable, même si la
#      variable ci-dessous est passée à true sur l'environnement Preview)
#   2. SEO_INDEXING_ENABLED === "true"
#   3. NEXT_PUBLIC_SITE_URL pointe sur dreamsfly.fr ou www.dreamsfly.fr
#
# Interrupteur volontaire. Tant qu'il n'est pas exactement "true" :
#   · toutes les pages sortent en noindex, nofollow
#   · aucune canonical n'est publiée (on préfère ne rien déclarer plutôt
#     que de désigner un domaine parqué — une canonical erronée est bien
#     plus longue à corriger auprès de Google qu'une absence d'indexation)
# robots.txt continue d'autoriser le crawl : Google doit pouvoir venir
# LIRE la balise noindex, un Disallow l'en empêcherait.
#
# Mise en production définitive :
#   NEXT_PUBLIC_SITE_URL=https://dreamsfly.fr
#   SEO_INDEXING_ENABLED=true
SEO_INDEXING_ENABLED=false

# ─── Resend (emails) ────────────────────────────
RESEND_API_KEY=
